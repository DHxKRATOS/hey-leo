{
  "kind": "collectionType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "Contact",
    "description": "User contacts and leads"
  },
  "options": {
    "timestamps": true
  },
  "attributes": {
    "first_name": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "last_name": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "email": {
      "type": "email",
      "unique": true,
      "required": true
    },
    "phone": {
      "type": "string",
      "maxLength": 20
    },
    "job_title": {
      "type": "string",
      "maxLength": 150
    },
    "company": {
      "type": "string",
      "maxLength": 150
    },
    "company_website": {
      "type": "string",
      "maxLength": 255
    },
    "website": {
      "type": "string",
      "maxLength": 255
    },
    "address": {
      "type": "text"
    },
    "city": {
      "type": "string",
      "maxLength": 100
    },
    "state": {
      "type": "string",
      "maxLength": 100
    },
    "country": {
      "type": "string",
      "maxLength": 100
    },
    "source": {
      "type": "enumeration",
      "enum": ["manual", "card_scan", "linkedin", "google", "referral", "event", "website", "other"],
      "default": "manual"
    },
    "linkedin_url": {
      "type": "string",
      "maxLength": 255
    },
    "tags": {
      "type": "json"
    },
    "notes": {
      "type": "text"
    },
    "last_contact": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user.user",
      "inversedBy": "contacts"
    },
    "card": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::card.card",
      "inversedBy": "captured_contacts"
    },
    "captured_data": {
      "type": "json",
      "description": "Raw form data captured from contact form"
    }
  }
}
