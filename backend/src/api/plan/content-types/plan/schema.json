{
  "kind": "collectionType",
  "collectionName": "plans",
  "info": {
    "singularName": "plan",
    "pluralName": "plans",
    "displayName": "Plan",
    "description": "Subscription plans"
  },
  "options": {
    "timestamps": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "description": {
      "type": "text"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "price_type": {
      "type": "enumeration",
      "enum": ["monthly", "yearly", "lifetime", "contact"],
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "plan_features": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::plan-feature.plan-feature",
      "mappedBy": "plan"
    },
    "user_subscription_plans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-subscription-plan.user-subscription-plan",
      "mappedBy": "plan"
    }
  }
}
