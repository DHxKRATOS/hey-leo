{
  "kind": "collectionType",
  "collectionName": "users",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User",
    "description": "Application users"
  },
  "options": {
    "timestamps": true
  },
  "attributes": {
    "email": {
      "type": "email",
      "unique": true,
      "required": true
    },
    "password_hash": {
      "type": "password",
      "required": true
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "avatar_url": {
      "type": "string",
      "maxLength": 512
    },
    "preferences": {
      "type": "json"
    },
    "password_changed_at": {
      "type": "datetime"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    },
    "last_login": {
      "type": "datetime"
    },
    "default_card_id": {
      "type": "integer"
    },
    "login_type": {
      "type": "enumeration",
      "enum": ["EMAIL", "GOOGLE", "LINKEDIN"],
      "default": "EMAIL"
    },
    "google_id": {
      "type": "string",
      "maxLength": 255
    },
    "linkedin_id": {
      "type": "string",
      "maxLength": 255
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "blocked": {
      "type": "boolean",
      "default": false
    },
    "user_subscription_plans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-subscription-plan.user-subscription-plan",
      "mappedBy": "user"
    },
    "cards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::card.card",
      "mappedBy": "user"
    },
    "contacts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact.contact",
      "mappedBy": "user"
    },
    "trains": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::train.train",
      "mappedBy": "user"
    },
    "form_definitions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::form-definition.form-definition",
      "mappedBy": "user"
    },
    "form_submissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::form-submission.form-submission",
      "mappedBy": "user"
    },
    "referrals_made": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::referral.referral",
      "mappedBy": "referrer"
    },
    "referrals_received": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::referral.referral",
      "mappedBy": "referee"
    },
    "contact_edits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact-edit-history.contact-edit-history",
      "mappedBy": "edited_by"
    },
    "improves": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::improve.improve",
      "mappedBy": "user"
    },
    "website_links": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::website-link.website-link",
      "mappedBy": "user"
    },
    "frequently_asked_questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::frequently-asked-question.frequently-asked-question",
      "mappedBy": "user"
    },
    "additional_informations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::additional-information.additional-information",
      "mappedBy": "user"
    },
    "referral_code": {
      "type": "string",
      "unique": true
    },
    "referred_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user.user",
      "inversedBy": "referrals"
    },
    "referrals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user.user",
      "mappedBy": "referred_by"
    },
    "analytics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::analytic.analytic",
      "mappedBy": "card"
    }
  }
}
