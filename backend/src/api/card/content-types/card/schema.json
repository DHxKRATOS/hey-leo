{
  "kind": "collectionType",
  "collectionName": "cards",
  "info": {
    "singularName": "card",
    "pluralName": "cards",
    "displayName": "Card",
    "description": "Digital business cards"
  },
  "options": {
    "timestamps": true
  },
  "attributes": {
    "card_creation_type": {
      "type": "enumeration",
      "enum": ["google", "linkedin", "email"],
      "required": true
    },
    "card_name": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "first_name": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "last_name": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "job_title": {
      "type": "string",
      "maxLength": 150
    },
    "company": {
      "type": "string",
      "maxLength": 150
    },
    "professional_bio_type": {
      "type": "enumeration",
      "enum": ["own", "AI", "linkedin"],
      "default": "own"
    },
    "description": {
      "type": "text"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "maxLength": 20
    },
    "linkedin_url": {
      "type": "string",
      "maxLength": 255
    },
    "calendar_url": {
      "type": "string",
      "maxLength": 255
    },
    "card_profile_link": {
      "type": "string",
      "maxLength": 255
    },
    "card_profile_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "card_views": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "card_leads": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "created_by": {
      "type": "biginteger"
    },
    "updated_by": {
      "type": "biginteger"
    },
    "twitter_url": {
      "type": "string",
      "maxLength": 255
    },
    "instagram_url": {
      "type": "string",
      "maxLength": 255
    },
    "website_url": {
      "type": "string",
      "maxLength": 255
    },
    "portfolio_url": {
      "type": "string",
      "maxLength": 255
    },
    "calendly_url": {
      "type": "string",
      "maxLength": 255
    },
    "custom_links": {
      "type": "json"
    },
    "location": {
      "type": "string",
      "maxLength": 255
    },
    "documents": {
      "type": "json"
    },
    "additional_information": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user.user",
      "inversedBy": "cards"
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "active", "paused"],
      "default": "draft"
    },
    "card_type": {
      "type": "enumeration",
      "enum": ["business", "personal", "networking"],
      "default": "business"
    },
    "contact_capture_enabled": {
      "type": "boolean",
      "default": false
    },
    "contact_capture_allow_skip": {
      "type": "boolean",
      "default": true
    },
    "contact_capture_header_message": {
      "type": "string",
      "maxLength": 200,
      "default": "Share your info back with me!"
    },
    "contact_capture_fields": {
      "type": "json",
      "default": [
        {
          "name": "full_name",
          "label": "Full Name",
          "type": "text",
          "required": true,
          "enabled": true
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "enabled": true
        },
        {
          "name": "phone",
          "label": "Phone",
          "type": "tel",
          "required": false,
          "enabled": false
        },
        {
          "name": "company",
          "label": "Company",
          "type": "text",
          "required": false,
          "enabled": false
        },
        {
          "name": "job_title",
          "label": "Job Title",
          "type": "text",
          "required": false,
          "enabled": false
        }
      ]
    },
    "captured_contacts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact.contact",
      "mappedBy": "card"
    },
    "training_documents": {
      "type": "json",
      "default": []
    },
    "training_website_links": {
      "type": "json",
      "default": []
    },
    "training_qa_pairs": {
      "type": "json",
      "default": []
    },
    "training_free_text": {
      "type": "text"
    },
    "ai_training_status": {
      "type": "enumeration",
      "enum": ["not_started", "processing", "completed", "error"],
      "default": "not_started"
    },
    "ai_training_last_updated": {
      "type": "datetime"
    },
    "analytics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::analytic.analytic",
      "mappedBy": "card"
    }
  }
}
